{
  "name": "edem-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:yandex": "tsc -b && vite build --mode yandex --outDir dist-yandex && cd dist-yandex && rm -f ../edem-yandex.zip && zip -qr ../edem-yandex.zip .",
    "build:vk": "tsc -b && vite build --mode vk --outDir dist-vk && cd dist-vk && rm -f ../edem-vk.zip && zip -qr ../edem-vk.zip ."
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
